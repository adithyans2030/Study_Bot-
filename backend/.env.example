# Copy to .env (git-ignored) and adjust. All keys are optional.
# STUDYBOT_HOME must NOT be inside OneDrive and must be short (Windows path limit): keep it under
# ~110 characters. Default: %LOCALAPPDATA%\StudyBot
# STUDYBOT_HOME=C:\StudyBot
# STUDYBOT_HOST=127.0.0.1
# STUDYBOT_PORT=8000

# Web app and accounts
# STUDYBOT_ALLOW_REGISTRATION=false   # the first account is always allowed; set true to let others sign up
# STUDYBOT_COOKIE_SECURE=false        # set true when served over HTTPS (e.g. through Tailscale)
# STUDYBOT_ALLOWED_ORIGINS=           # extra origins allowed to make changes, e.g. https://mypc.tailnet.ts.net
# STUDYBOT_MAX_UPLOAD_MB=100
# STUDYBOT_SESSION_DAYS=14
# STUDYBOT_LOGIN_MAX_FAILURES=5       # failed sign-ins per username+IP per 5 minutes
# STUDYBOT_WARM_ON_START=true         # load the models in the background when the server starts

# LLM (Ollama). gemma2:2b is the current default; llama3.2:3b / qwen2.5:3b are candidates.
# STUDYBOT_OLLAMA_URL=http://127.0.0.1:11434
# STUDYBOT_LLM_MODEL=gemma2:2b
# STUDYBOT_NUM_CTX=4096

# Retrieval
# STUDYBOT_EMBED_MODEL=BAAI/bge-small-en-v1.5
# STUDYBOT_USE_RERANKER=false
# STUDYBOT_RETRIEVE_K=4
# STUDYBOT_MIN_DENSE_SCORE=0.55

# Conversations
# STUDYBOT_FOLLOWUP_MODE=llm          # how a follow-up is turned into a search: off | concat | llm
# STUDYBOT_HISTORY_TURNS=3            # earlier question/answer pairs used to understand a follow-up

# Voice input (offline speech-to-text, faster-whisper). Reading answers aloud uses the browser's own voices.
# STUDYBOT_VOICE_ENABLED=true
# STUDYBOT_STT_MODEL=base.en          # small.en is more accurate but 5-8x slower on CPU
# STUDYBOT_STT_THREADS=4
# STUDYBOT_MAX_AUDIO_MB=10
# STUDYBOT_MAX_AUDIO_SECONDS=120

# Chunking (approximate tokens)
# STUDYBOT_CHUNK_TARGET_TOKENS=320
# STUDYBOT_CHUNK_MAX_TOKENS=420
# STUDYBOT_CHUNK_MIN_TOKENS=80
# STUDYBOT_CHUNK_OVERLAP_TOKENS=40
